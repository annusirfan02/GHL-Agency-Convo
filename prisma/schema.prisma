// Prisma schema for GHL → Google Sheet export tool.
// Tracks exported contacts to prevent duplicate rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tracks which contacts have been exported to the sheet
model ExportedContact {
  id          String   @id @default(cuid())
  contactId   String   @unique
  email       String   @unique
  locationId  String
  exportedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@map("exported_contacts")
}
