{
  "name": "ghl-to-google-sheet",
  "version": "3.0.0",
  "description": "Export GHL Agency 1 conversations to Google Sheets",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build":       "prisma generate && tsc",
    "start":       "node dist/server.js",
    "dev":         "ts-node-dev --respawn --transpile-only src/server.ts",
    "sheet":       "ts-node-dev --transpile-only src/sheet/exportToSheet.ts",
    "db:migrate":  "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:push":     "prisma db push",
    "db:studio":   "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "axios":          "1.7.9",
    "dotenv":         "16.4.7",
    "express":        "4.21.2",
    "googleapis":     "144.0.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node":    "22.10.2",
    "prisma":         "5.22.0",
    "ts-node-dev":    "2.0.0",
    "typescript":     "5.7.2"
  }
}
