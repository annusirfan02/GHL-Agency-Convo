  },
  "dependencies": {
    "axios":   "1.7.9",
    "dotenv":  "16.4.7",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node":    "22.10.2",
    "ts-node-dev":    "2.0.0",
    "typescript":     "5.7.2"
  }
}
