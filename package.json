{
  "name": "ghl-conversation-sync",
  "version": "2.0.0",
  "description": "Syncs historical and real-time conversations between two GHL subaccounts",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build":           "prisma generate && tsc",
    "start":           "node dist/server.js",
    "dev":             "ts-node-dev --respawn --transpile-only src/server.ts",
    "sync":            "ts-node-dev --transpile-only src/cli.ts",
    "sync:build":      "node dist/cli.js",
    "db:migrate":      "prisma migrate deploy",
    "db:generate":     "prisma generate",
    "db:push":         "prisma db push",
    "db:studio":       "prisma studio",
    "railway:migrate": "prisma migrate deploy && node dist/cli.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "axios":          "1.7.9",
    "dotenv":         "16.4.7",
    "express":        "4.21.2"
  },
  "devDependencies": {
    "@types/express":  "4.17.21",
    "@types/node":     "22.10.2",
    "prisma":          "5.22.0",
    "ts-node-dev":     "2.0.0",
    "typescript":      "5.7.2"
  }
}
