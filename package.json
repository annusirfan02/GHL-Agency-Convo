{
  "name": "ghl-to-csv",
  "version": "4.0.0",
  "description": "Export GHL Agency 1 conversations to CSV download",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
