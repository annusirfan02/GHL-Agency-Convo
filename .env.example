SOURCE_GHL_ACCESS_TOKEN=your_source_private_integration_token_here
SOURCE_GHL_LOCATION_ID=your_source_location_id_here

DESTINATION_GHL_ACCESS_TOKEN=your_destination_private_integration_token_here
DESTINATION_GHL_LOCATION_ID=your_destination_location_id_here

DATABASE_URL="postgresql://user:password@localhost:5432/ghl_sync"

PORT=3000
VERIFY_WEBHOOK_SIGNATURE=false

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE SHEETS EXPORT
# ─────────────────────────────────────────────────────────────────────────────

# Your Google Sheet ID (from the URL)
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Sheet tab name (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Google Service Account credentials as JSON string
# See GOOGLE_SETUP.md for how to get this
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
